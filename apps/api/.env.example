NODE_ENV=development
PORT=3001

# Origin allowed by CORS (the web app). In production, your Vercel URL.
WEB_ORIGIN=http://localhost:3000

# --- Local database (discrete vars) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobtracker
DB_PASSWORD=jobtracker
DB_NAME=jobtracker

# --- Production database ---
# Managed Postgres (e.g. Neon) gives a single connection URL. When DATABASE_URL
# is set it takes precedence over the DB_* vars above, and SSL must be on.
# DATABASE_URL=postgresql://user:password@host/dbname
DB_SSL=false

# Schema management:
#  - Local dev:    DB_SYNCHRONIZE=true  (auto-syncs the schema from entities)
#  - Production:   DB_SYNCHRONIZE=false and DB_MIGRATIONS_RUN=true (run migrations on boot)
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false

# Secret used to sign JWTs. Generate a strong one: openssl rand -base64 32
JWT_SECRET=change-me
